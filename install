#!/usr/bin/env bash
# Install the build units, the status page (generator and build trigger) and the web server, and
# enable the timers
# (run as root on the build server). Idempotent: run it again after changes to systemd/ or serve/.
# Usage: [ARKDEP_RECIPES="p14s ..."] [BOOTC_RECIPES="t480 ..."] install
# Weekly builds: the arkdep images of ARKDEP_RECIPES (default p14s) and the bootc images of
# BOOTC_RECIPES (default t480), what each laptop runs. The timers of the other recipes are disabled:
# every recipe's builds stay available by hand (systemctl start, or the status page).

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

read -ra arkdep_recipes <<<"${ARKDEP_RECIPES-p14s}"
read -ra bootc_recipes <<<"${BOOTC_RECIPES-t480}"
timers=()
for recipe in "${arkdep_recipes[@]}"; do timers+=("build-image@$recipe.timer"); done
for recipe in "${bootc_recipes[@]}"; do timers+=("build-bootc@$recipe.timer"); done

ln -sf "$(pwd)"/systemd/build-{image@,bootc@,aur}.{service,timer} "$(pwd)"/systemd/build-iso.service \
	"$(pwd)"/systemd/distro-status.{service,timer} "$(pwd)"/systemd/distro-trigger.{service,socket} \
	/etc/systemd/system/
ln -sf "$(pwd)"/serve/distro-{repo,registry}.container /etc/containers/systemd/
# Registry storage and the bootc images' package lists (notify-image), on the NFS pool
mkdir -p /mnt/repo/registry /mnt/repo/bootc
ln -sf "$(pwd)"/serve/distro-status.tmpfiles /etc/tmpfiles.d/distro-status.conf
systemd-tmpfiles --create /etc/tmpfiles.d/distro-status.conf
# Copied, not linked: polkitd cannot read the admin home directory
install -m 644 serve/distro-trigger.rules /etc/polkit-1/rules.d/50-distro-trigger.rules
# bootc/build signs the bootc images with a sigstore key and podman writes the signatures to the
# registry next to them: same registries.d file as the bootc systems
install -D -m 644 bootc/overlay/etc/containers/registries.d/50-distro-builder.yaml \
	/etc/containers/registries.d/50-distro-builder.yaml
[[ -r /etc/distro-builder/sigstore/distro-builder.private ]] ||
	echo "No sigstore key in /etc/distro-builder/sigstore (homelab vault): bootc images will not be signed" >&2
systemctl daemon-reload

systemctl enable --now build-aur.timer
for link in /etc/systemd/system/timers.target.wants/build-{image,bootc}@*.timer; do
	timer=${link##*/}
	[[ -L $link && " ${timers[*]} " != *" $timer "* ]] && systemctl disable --now "$timer"
done
((${#timers[@]})) && systemctl enable --now "${timers[@]}"
systemctl enable --now distro-status.timer distro-trigger.socket podman-auto-update.timer
systemctl try-restart distro-trigger.service  # new code of serve/build-trigger
systemctl start distro-status.service  # first status before the web server serves the page
systemctl restart distro-repo.service distro-registry.service
