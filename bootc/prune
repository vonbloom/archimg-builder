#!/usr/bin/env bash
# Usage: prune [--dry-run] <recipe>
# Keep the newest KEEP (default 4, a month of weekly builds) dated tags of <recipe> in the registry
# (latest is the newest one), delete the older ones and their package lists, then let the registry
# delete the blobs no image uses any more and restart it. Run under /run/build-image.lock: garbage
# collection must not race with a push.

set -euo pipefail

DRY_RUN=0
[[ ${1:-} == --dry-run ]] && DRY_RUN=1 && shift
RECIPE=${1:?A recipe must be specified}
REGISTRY=${REGISTRY:-localhost:5000}
PKGS_DIR=${PKGS_DIR:-/mnt/repo/bootc/$RECIPE}
REGISTRY_CONTAINER=${REGISTRY_CONTAINER:-distro-registry}
REGISTRY_RESTART=${REGISTRY_RESTART:-systemctl restart distro-registry.service}
KEEP=${KEEP:-4}

api=http://$REGISTRY/v2/$RECIPE
accept=(-H 'Accept: application/vnd.oci.image.manifest.v1+json'
	-H 'Accept: application/vnd.oci.image.index.v1+json'
	-H 'Accept: application/vnd.docker.distribution.manifest.v2+json')

mapfile -t tags < <(curl -fsS "$api/tags/list" |
	python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin).get("tags") or []))' |
	grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' | sort -r)

deleted=0
for i in "${!tags[@]}"; do
	tag=${tags[$i]}
	if ((i < KEEP)); then
		echo "keep   $RECIPE:$tag"
		continue
	fi
	echo "delete $RECIPE:$tag"
	((DRY_RUN)) && continue
	digest=$(curl -fsSI "${accept[@]}" "$api/manifests/$tag" |
		tr -d '\r' | awk -F': ' 'tolower($1) == "docker-content-digest" { print $2 }')
	[[ -n $digest ]] || { echo "no digest for $RECIPE:$tag" >&2; exit 1; }
	curl -fsS -X DELETE "$api/manifests/$digest"
	# Its sigstore signature, a tag of its own (bootc/build)
	# (none for the images pushed before 2026-10-08)
	sig=$({ curl -fsSI "${accept[@]}" "$api/manifests/${digest/:/-}.sig" 2>/dev/null || true; } |
		tr -d '\r' | awk -F': ' 'tolower($1) == "docker-content-digest" { print $2 }')
	[[ -n $sig ]] && curl -fsS -X DELETE "$api/manifests/$sig" && echo "delete $RECIPE:${digest/:/-}.sig"
	rm -f "$PKGS_DIR/$RECIPE-$tag.pkgs"
	deleted=$((deleted + 1))
done

if ((deleted)); then
	out=$(podman exec "$REGISTRY_CONTAINER" registry garbage-collect --delete-untagged \
		/etc/docker/registry/config.yml 2>&1) || { echo "$out" >&2; exit 1; }
	echo "Garbage collection: $(grep -c 'Deleting blob' <<<"$out") blobs deleted"
	# registry:2 caches blob descriptors in memory: without a restart, a later push skips uploading
	# a blob that the collection just deleted (seen in a test) and publishes a broken image
	$REGISTRY_RESTART
fi
