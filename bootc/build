#!/usr/bin/env bash
# Usage: build <recipe>
# Build the bootc image of an arkdep recipe (bootc/Containerfile), split it into per-package layers
# with chunkah (an update then downloads only the packages that changed) and push it to the
# registry as <recipe>:YYYY-MM-DD and <recipe>:latest with skopeo. The package list is written to
# PKGS_DIR for notify-image.
# Local test run: REGISTRY=127.0.0.1:5000 PKGS_DIR=/some/dir AUR_SERVER=... AUR_SIGLEVEL=Never
# Test run on the build server: REPOSITORY=test/<recipe> PKGS_DIR=/some/dir (next to the real
# images, not over them; delete its manifests through the registry API afterwards)

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

RECIPE=${1:?A recipe must be specified}
# The name clients pull from: the signature names the image it signs (matchRepository in the
# clients' policy.json), so the push goes to the LAN address, not localhost
REGISTRY=${REGISTRY:-192.168.2.50:5000}
REPOSITORY=${REPOSITORY:-$RECIPE}
SIGSTORE_DIR=${SIGSTORE_DIR:-/etc/distro-builder/sigstore}  # private key and its passphrase, root only
PKGS_DIR=${PKGS_DIR:-/mnt/repo/bootc/$RECIPE}
# Pinned: an update of chunkah's gzip could change the bytes of unchanged layers, and every client
# would download the whole image again
CHUNKAH=${CHUNKAH:-quay.io/coreos/chunkah:v0.7.0}
SKOPEO=${SKOPEO:-quay.io/skopeo/stable:v1.22.3}
read -r TAG BUILD_TIME < <(date +'%Y-%m-%d %H%M')
IMAGE=localhost/bootc-$RECIPE

# The boot menu shows the tag; the time tells apart two builds of the same day
build_args=(--build-arg "RECIPE=$RECIPE" --build-arg "VERSION=$TAG" --build-arg "VERSION_ID=$TAG.$BUILD_TIME")
[[ -n ${AUR_SERVER:-} ]] && build_args+=(--build-arg "AUR_SERVER=$AUR_SERVER")
[[ -n ${AUR_SIGLEVEL:-} ]] && build_args+=(--build-arg "AUR_SIGLEVEL=$AUR_SIGLEVEL")

mkdir -p "$PKGS_DIR"

# --no-cache: a weekly build must install the current packages, not reuse last week's layers
podman build --pull=always --no-cache --no-hostname -f bootc/Containerfile "${build_args[@]}" \
	-t "$IMAGE" .

podman run --rm --entrypoint pacman "$IMAGE" -Q >"$PKGS_DIR/$RECIPE-$TAG.pkgs"

# chunkah's output, an OCI directory layout (~1 GiB): /var/tmp, not the tmpfs /tmp
work=$(mktemp -d /var/tmp/bootc-build.XXXXXX)
trap 'rm -rf -- "$work"' EXIT

# One layer per group of packages instead of one per Containerfile step (the recipe step alone is
# ~3.5 GB). chunkah reads the pacman database (DBPath in the image's pacman.conf). The version goes
# to the config labels (bootc's ostree backend reads them) and the manifest annotations (the
# composefs backend reads only these: bootc-dev/bootc#2227). The layers are gzip-compressed once,
# here, and pushed as they are: no import into containers-storage (~3.5 GB uncompressed) and no
# recompression by podman push
CHUNKAH_CONFIG_STR=$(podman inspect "$IMAGE")
export CHUNKAH_CONFIG_STR
podman run --rm --mount=type=image,src="$IMAGE",target=/chunkah -v "$work:/out" \
	-e CHUNKAH_CONFIG_STR "$CHUNKAH" build --label ostree.bootable=1 --label containers.bootc=1 \
	--label org.opencontainers.image.version="$TAG" --annotation org.opencontainers.image.version="$TAG" \
	--compressed --max-layers 128 -o oci:/out/image

# Signed with the build server's sigstore key: the signature goes to the registry next to the image
# (sha256-<digest>.sig, /etc/containers/registries.d/50-distro-builder.yaml, mounted into the
# skopeo container), and the bootc systems refuse unsigned images
# (bootc/overlay/etc/containers/policy.json). One signature covers both tags: they name the same
# manifest digest
mounts=(-v "$work:/work" -v /etc/containers/registries.d:/etc/containers/registries.d:ro)
sign=()
if [[ -r $SIGSTORE_DIR/distro-builder.private ]]; then
	mounts+=(-v "$SIGSTORE_DIR:$SIGSTORE_DIR:ro")
	sign=(--sign-by-sigstore-private-key "$SIGSTORE_DIR/distro-builder.private"
		--sign-passphrase-file "$SIGSTORE_DIR/passphrase")
else
	echo "No signing key ($SIGSTORE_DIR): the image is not signed, bootc systems will refuse it" >&2
fi
# --preserve-digests: the manifest goes up byte for byte (chunkah's annotations, OCI format: the
# composefs backend fails on Docker v2s2 manifests, bootc-dev/bootc#1703); skopeo fails instead of
# rewriting it. Blobs already in the registry are skipped
copy=(copy --preserve-digests --dest-tls-verify=false --digestfile /work/digest)
skopeo() { podman run --rm --network host "${mounts[@]}" "$SKOPEO" "$@"; }
skopeo "${copy[@]}" "${sign[@]}" oci:/work/image "docker://$REGISTRY/$REPOSITORY:$TAG"
skopeo "${copy[@]}" --quiet oci:/work/image "docker://$REGISTRY/$REPOSITORY:latest"
echo "Pushed $REGISTRY/$REPOSITORY:$TAG ($(<"$work/digest"))${sign:+, signed}"

# The registry holds the image: do not keep a ~4 GB copy on the build server's disk
podman rmi "$IMAGE" >/dev/null
podman image prune -f >/dev/null
