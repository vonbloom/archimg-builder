[Unit]
Description=Build AUR packages and publish them in the aur repository
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/repo
# notify-failure@ comes from the homelab repo (notify_ha role)
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# Bring the checkout up to date first (fast-forward only). A failed pull (GitHub down, local
# changes) does not stop the build: it runs with the code already there.
ExecStartPre=-/usr/bin/flock /run/distro-builder-git.lock /usr/sbin/runuser -u admin -- git -C /home/admin/distro-builder pull --ff-only
# One build at a time with the images: the bootc builds install bootc from [aur] (no repository
# update during their pacman -Sy), and the 8 GB VM cannot hold a bootc build (~7 GB peak with
# podman load, ~3 GB since the skopeo push) and a Rust compile at once
ExecStart=/usr/bin/flock /run/build-image.lock /home/admin/distro-builder/aur/build
# New upstream releases of the own PKGBUILDs (aur/local), reported once; never fails the unit
ExecStartPost=-/home/admin/distro-builder/aur/check-upstream
TimeoutStartSec=3h
