[Unit]
Description=Build the %i arkdep image and publish it
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/repo
# notify-failure@ comes from the homelab repo (notify_ha role)
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# Bring the checkout up to date first (fast-forward only). A failed pull (GitHub down, local
# changes) does not stop the build: it runs with the code already there.
ExecStartPre=-/usr/bin/flock /run/distro-builder-git.lock /usr/sbin/runuser -u admin -- git -C /home/admin/distro-builder pull --ff-only
# Builds of different recipes are started together by their timers: run them one at a time
ExecStart=/usr/bin/flock /run/build-image.lock /home/admin/distro-builder/image/build %i
ExecStartPost=/home/admin/distro-builder/image/prune %i
ExecStartPost=/home/admin/distro-builder/image/notify-image %i
TimeoutStartSec=6h
