#!/usr/bin/env bash
# Usage: prune [--dry-run] <recipe>
# Thin out old images of a recipe in /mnt/repo/<recipe>: keep the newest KEEP_RECENT images
# (default 4, a month of weekly builds) plus the newest image of each of the KEEP_MONTHLY
# (default 3) previous months. Deleted images are removed from the database too.

set -euo pipefail

DRY_RUN=0
[[ ${1:-} == --dry-run ]] && DRY_RUN=1 && shift
RECIPE=${1:?A recipe must be specified}
REPO_PATH=/mnt/repo/$RECIPE
KEEP_RECENT=${KEEP_RECENT:-4}
KEEP_MONTHLY=${KEEP_MONTHLY:-3}

# Image names are <recipe>-YYYY-MM-DD (name.sh), so a reverse sort is newest first
mapfile -t images < <(find "$REPO_PATH" -maxdepth 1 -name '*.tar.zst' -printf '%f\n' |
	sed 's/\.tar\.zst$//' | sort -r)

declare -A kept_months=()
recent=0 monthly=0
for img in "${images[@]}"; do
	month=$(grep -oE '[0-9]{4}-[0-9]{2}' <<<"$img" | head -1)
	if ((recent < KEEP_RECENT)); then
		recent=$((recent + 1)) kept_months[$month]=1
		echo "keep   $img (recent)"
	elif [[ -z ${kept_months[$month]:-} ]] && ((monthly < KEEP_MONTHLY)); then
		monthly=$((monthly + 1)) kept_months[$month]=1
		echo "keep   $img (monthly)"
	else
		echo "delete $img"
		if ((!DRY_RUN)); then
			sed -i "/^$img:/d" "$REPO_PATH/database"
			rm -f "$REPO_PATH/$img.tar.zst" "$REPO_PATH/$img.pkgs"
		fi
	fi
done
