# Local variant of the AUR package (https://aur.archlinux.org/packages/bootc), built by aur/build
# into the [aur] repository: without the selinux feature, which links libselinux (not in the Arch
# repositories), and with skopeo in depends. Reported to the AUR package:
# https://aur.archlinux.org/packages/bootc#comment-1087447
# The version only changes here: bump pkgver (and sha256sums) after checking that it builds.
# aur/check-upstream (daily, after build-aur) reports new releases of bootc-dev/bootc;
# aur/bump-local bootc sets pkgver and sha256sums for the latest one.

pkgname=bootc
pkgver=1.17.1
pkgrel=1
pkgdesc='Boot and upgrade via container images'
url='https://github.com/bootc-dev/bootc'
license=('Apache-2.0 OR MIT')
makedepends=(
    cargo
    go-md2man
)
depends=(
    bash
    skopeo
    gcc-libs
    glib2
    glibc
    openssl
    ostree
    zlib
    zstd
)
arch=('x86_64')
source=("https://github.com/bootc-dev/bootc/releases/download/v$pkgver/bootc-$pkgver.tar.zstd")
sha256sums=('8d06b7b20e6a3fe862275f089a2ac5275ff91151de2e3f0ef090a426292ab3dd')

prepare() {
    cd $pkgname-$pkgver
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

# The default features include selinux (libselinux is not in the Arch repositories); keep
# pre-6.15 (composefs on kernels older than 6.15, e.g. linux-lts), as in the Makefile example
_features=(--no-default-features --features install-to-disk,pre-6.15)

build() {
    export CARGO_TARGET_DIR=target
    cd $pkgname-$pkgver
    cargo build --frozen --release "${_features[@]}"
    cargo run --frozen --package xtask -- manpages -- "${_features[@]}"
}

check() {
    cd $pkgname-$pkgver
    cargo test --frozen "${_features[@]}"
}

package() {
    make -C $pkgname-$pkgver DESTDIR=$pkgdir CARGO_OPTIONS="${_features[*]}" install

    install -m 644 -t $pkgdir/usr/share/doc/$pkgname -D $pkgname-$pkgver/README.md

    install -m 644 -t $pkgdir/usr/share/licenses/$pkgname -D $pkgname-$pkgver/LICENSE-APACHE
    install -m 644 -t $pkgdir/usr/share/licenses/$pkgname -D $pkgname-$pkgver/LICENSE-MIT
}
