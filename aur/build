#!/usr/bin/env bash
# Usage: build [--rebuild-builder] [repo_path]

set -euo pipefail

REBUILD=0
[[ ${1:-} == --rebuild-builder ]] && REBUILD=1 && shift

cd "$(dirname "$(readlink -f "$0")")"

REPO_PATH="${1:-/mnt/repo/aur}"
BUILDER_IMAGE=aur-builder
BUILDER_MAX_AGE_DAYS=7

[[ ! -d $REPO_PATH ]] && mkdir -p "$REPO_PATH"

# Rebuild the builder image if missing, too old or requested; packages are upgraded on every run anyway
CREATED=$(podman image inspect -f '{{.Created.Unix}}' "$BUILDER_IMAGE" 2>/dev/null || true)
if [[ -z $CREATED ]] || ((REBUILD)) ||
	(($(date +%s) - CREATED > BUILDER_MAX_AGE_DAYS * 86400)); then
	podman build --pull=always --no-cache --rm -t "$BUILDER_IMAGE" . &&
		podman image prune -f
fi

podman run --rm \
	-v "$(pwd)"/packages.list:/packages.list:ro,Z \
	-v "$REPO_PATH":/repo:Z \
	"$BUILDER_IMAGE"
