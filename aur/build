#!/usr/bin/env bash
# Usage: build [--rebuild-builder] [repo_path]

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"
source ../lib/builder.sh

REBUILD=0
[[ ${1:-} == --rebuild-builder ]] && REBUILD=1 && shift

REPO_PATH="${1:-/mnt/repo/aur}"
BUILDER_IMAGE=aur-builder

[[ ! -d $REPO_PATH ]] && mkdir -p "$REPO_PATH"

# Packages are upgraded on every run anyway; the image age only matters for aurutils
ensure_builder "$BUILDER_IMAGE" . "$REBUILD"

# Named after the unit (its log lines carry the name); --replace removes a leftover of a killed run
podman run --rm --replace --name build-aur \
	-v "$(pwd)"/packages.list:/packages.list:ro,Z \
	-v "$REPO_PATH":/repo:Z \
	"$BUILDER_IMAGE"
