#!/usr/bin/env bash
# Usage: build [--rebuild-builder] [repo_path]

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"
source ../lib/builder.sh
source ../lib/sign.sh

REBUILD=0
[[ ${1:-} == --rebuild-builder ]] && REBUILD=1 && shift

REPO_PATH="${1:-/mnt/repo/aur}"
BUILDER_IMAGE=aur-builder

[[ ! -d $REPO_PATH ]] && mkdir -p "$REPO_PATH"

# Packages are upgraded on every run anyway; the image age only matters for aurutils
ensure_builder "$BUILDER_IMAGE" . "$REBUILD"

# Named after the unit (its log lines carry the name); --replace removes a leftover of a killed run.
# The script and makepkg.conf are mounted from the checkout, so changes apply on the next run instead
# of when the builder image is rebuilt (weekly)
podman run --rm --replace --name build-aur \
	-v "$(pwd)"/aur-build.sh:/usr/bin/aur-build.sh:ro,Z \
	-v "$(pwd)"/makepkg.conf:/etc/makepkg.conf.d/aur-builder.conf:ro,Z \
	-v "$(pwd)"/packages.list:/packages.list:ro,Z \
	-v "$(pwd)"/local:/local:ro,Z \
	-v "$REPO_PATH":/repo:Z \
	"$BUILDER_IMAGE"

# Sign outside the container, which never sees the key: new packages, and the databases, which
# change on every run (aur.db and aur.files, for pacman -F, are symlinks to the .tar.zst files;
# pacman fetches aur.db.sig and aur.files.sig)
if can_sign; then
	(
		cd "$REPO_PATH"
		shopt -s nullglob
		for sig in *.pkg.tar.zst.sig; do
			[[ -e ${sig%.sig} ]] || rm -v "$sig" # package removed by aur-build.sh or paccache
		done
		sign_missing ./*.pkg.tar.zst
		for db in *.db.tar.zst *.files.tar.zst; do
			sign "$db"
			ln -sf "$db.sig" "${db%.tar.zst}.sig"
		done
	)
else
	echo "No signing key ($SIGN_GNUPGHOME): packages not signed" >&2
fi
