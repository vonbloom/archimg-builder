#!/usr/bin/env bash
# Wallpaper picker (rofi) for ~/.local/share/wallpapers (subfolders dia/ and nit/ included),
# opened by $mod+Shift+w. The choice lasts until the next pickwall run (random wallpaper timer).

set -uo pipefail

dir=$HOME/.local/share/wallpapers
choice=$(find "$dir" -type f -printf '%P\n' | sort |
	rofi -dmenu -i -no-custom -p "Fons de pantalla") || exit 0
swaymsg "output * bg \"$dir/$choice\" fill"
