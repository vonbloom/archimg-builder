#!/usr/bin/env bash
# Wallpaper picker (rofi) for ~/.local/share/wallpapers, opened by $mod+Shift+w.
# The choice lasts until the next pickwall run (random wallpaper timer).

set -uo pipefail

dir=$HOME/.local/share/wallpapers
choice=$(find "$dir" -maxdepth 1 -type f -printf '%f\n' | sort |
	rofi -dmenu -i -no-custom -p "Fons de pantalla") || exit 0
swaymsg "output * bg \"$dir/$choice\" fill"
