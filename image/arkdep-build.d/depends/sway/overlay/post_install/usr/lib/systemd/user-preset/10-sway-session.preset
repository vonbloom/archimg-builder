enable sway-session.target
enable waybar.service
enable swayidle.service
enable pickwall.service
enable pickwall.timer
enable wlsunset.service
enable pipewire.service
enable pipewire-pulse.service
enable wireplumber.service
enable xdg-desktop-portal.service
enable xdg-desktop-portal-wlr.service
enable podman.socket
# Socket activated only: enabling the service too races with the socket at login
disable podman.service
# Started by sway-session.target, not at login (its [Install] says default.target)
disable darkman.service
enable deploy-userland.service
