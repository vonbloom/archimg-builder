#%PAM-1.0
# Arch's passwd (shadow) plus pam_gnome_keyring: changing the login password changes the password
# of the "login" keyring too (it is unlocked with the login password, /etc/pam.d/login)
auth		include		system-auth
account		include		system-auth
password	include		system-auth
password	optional	pam_gnome_keyring.so
