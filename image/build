#!/usr/bin/env bash
# Usage: build [--rebuild-builder] <recipe>

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"
source ../lib/builder.sh
source ../lib/sign.sh

REBUILD=0
[[ ${1:-} == --rebuild-builder ]] && REBUILD=1 && shift

[[ -z ${1:-} ]] && echo "A recipe must be specified" && exit 1
[[ $# -gt 1 ]] && echo "Only one argument allowed" && exit 1

RECIPE="$1"
REPO_PATH="/mnt/repo/$RECIPE"
BUILDER_IMAGE=arkdep-builder

[[ ! -d $REPO_PATH ]] && mkdir "$REPO_PATH"

ensure_builder "$BUILDER_IMAGE" . "$REBUILD"
echo "Builder: $(podman run --rm --replace --name "build-image-$RECIPE-version" --entrypoint pacman "$BUILDER_IMAGE" -Q arkdep)"

# Build recipe image. The container is named after the unit (its log lines carry the name);
# --replace removes a leftover of a killed run with the same name
podman run \
	--privileged --rm --replace --name "build-image-$RECIPE" \
	-v "$(pwd)"/arkdep-build.d:/root/arkdep-build.d:Z \
	-v "$(pwd)"/../keys:/root/keys:ro \
	-v "$REPO_PATH":/root/target:Z \
	"$BUILDER_IMAGE" "$RECIPE"

# Sign the new image (arkdep checks <image>.tar.zst.sig), also when it replaced one of the same
# name, and any older one still unsigned
if can_sign; then
	sign_stale "$REPO_PATH"/*.tar.zst
else
	echo "No signing key ($SIGN_GNUPGHOME): images not signed" >&2
fi
