[Unit]
Description=Web service for the arkdep images, the aur repository and the installer ISO
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/nginx:alpine
PublishPort=80:80
Volume=/home/admin/distro-builder/serve/nginx.conf:/etc/nginx/conf.d/default.conf:Z
Volume=/mnt/repo:/usr/share/nginx/html:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
