#!/usr/bin/env python3
"""Start build units from the status page (serve/web/index.html).

Socket activated (distro-trigger.socket, /run/distro-trigger/trigger.sock); nginx proxies
POST /api/build/<unit> to it. Runs as admin: the polkit rule (serve/distro-trigger.rules) only lets
it start the build units and the status generator.
"""

import http.server
import json
import os
import re
import socket
import socketserver
import subprocess
import sys
from urllib.parse import unquote

API = re.compile(r"/api/build/([A-Za-z0-9@._-]+)")


def systemctl(*args):
    return subprocess.run(["systemctl", "--no-ask-password", *args],
                          capture_output=True, text=True, timeout=30, check=False)


def build_units():
    """Same units as the status page (serve/status-gen): those with a build-* timer, plus build-iso."""
    out = systemctl("list-units", "--all", "--plain", "--no-legend", "--type=timer", "build-*").stdout
    timers = (line.split()[0] for line in out.splitlines() if line.strip())
    return {t[: -len(".timer")] + ".service" for t in timers} | {"build-iso.service"}


class Handler(http.server.BaseHTTPRequestHandler):
    def reply(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        # A cross-site form cannot send this header, and a cross-site fetch with it needs a CORS
        # preflight that is never answered: only the status page itself can start builds
        if self.headers.get("X-Distro-Builder") != "1":
            return self.reply(403, {"error": "missing X-Distro-Builder header"})
        m = API.fullmatch(unquote(self.path))  # the page encodes the @ of build-image@<recipe>
        unit = m.group(1) if m else None
        if unit not in build_units():
            return self.reply(404, {"error": f"not a build unit: {unit}"})
        if systemctl("show", "-P", "ActiveState", unit).stdout.strip() in ("activating", "active", "deactivating"):
            return self.reply(409, {"error": f"{unit} is already running"})
        r = systemctl("start", "--no-block", unit)
        if r.returncode:
            return self.reply(500, {"error": r.stderr.strip()})
        systemctl("start", "--no-block", "distro-status.service")  # show it as running right away
        self.log_message("started %s", unit)
        self.reply(202, {"started": unit})

    def log_message(self, fmt, *args):
        # Unix socket: no client address, nginx passes it in X-Real-IP
        print(f"{self.headers.get('X-Real-IP', '-')} {fmt % args}", file=sys.stderr, flush=True)


def main():
    if os.environ.get("LISTEN_FDS") != "1":
        sys.exit("Start it through distro-trigger.socket")
    server = socketserver.UnixStreamServer("", Handler, bind_and_activate=False)
    server.socket = socket.socket(fileno=3)
    server.serve_forever()


if __name__ == "__main__":
    main()
