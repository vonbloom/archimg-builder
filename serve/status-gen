#!/usr/bin/env python3
"""Write the build server status read by the web page (serve/web/index.html).

Runs as root every minute (distro-status.timer): reads the build units from systemd and the
journal, and the files published under /mnt/repo, and writes to the output directory (default
/run/distro-status, served at /status/):

  status.json        units, images per recipe with package changes (arkdep from /mnt/repo, bootc
                     from the registry), [aur] packages, ISO, storage
  recipes.txt        one recipe per line (read by the installer to offer a recipe menu)
  logs/<unit>.txt    journal of the last run of each build unit

Usage: status-gen [--out DIR] [--repo DIR]
"""

import argparse
import json
import os
import re
import socket
import subprocess
import tempfile
import time
import urllib.request

LOG_LINES = 1500
REGISTRY = "http://localhost:5000"  # serve/distro-registry.container (bootc images)
MANIFEST_TYPES = ", ".join([
    "application/vnd.oci.image.manifest.v1+json",
    "application/vnd.docker.distribution.manifest.v2+json",
])
DATE_TAG = re.compile(r"\d{4}-\d{2}-\d{2}")
CHECKOUT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
UNIT_PROPS = [
    "Description",
    "LoadState",
    "ActiveState",
    "Result",
    "InactiveExitTimestamp",
    "InactiveEnterTimestamp",
]
TIMER_PROPS = ["NextElapseUSecRealtime", "LastTriggerUSec"]
# Journal messages of PID 1 about a unit's jobs (catalog IDs)
MSG_STARTING = "7d4958e842da4a758f6c1cdc7b36dcc5"
MSG_JOB_DONE = "39f53479d3a045ac8e11786248231fbf"
MSG_JOB_FAILED = "be02cf6855d2428ba40df7e9d022f03d"
MSG_UNIT_FAILED = "d9b373ed55a64feb8242e02dbe79a49c"


def run(cmd):
    """Output of a command, or "" if it fails: the status page must always be written."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60, check=False).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def show(unit, props):
    out = run(["systemctl", "show", unit, "--timestamp=unix", "-p", ",".join(props)])
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


def epoch(value):
    """systemctl --timestamp=unix prints "@<seconds>", but timer properties such as
    NextElapseUSecRealtime ignore it and print a date ("Tue 2026-10-06 04:14:38 UTC").
    Empty, "0" or "n/a" when unset."""
    value = (value or "").strip()
    m = re.fullmatch(r"@(\d+)", value)
    if m:
        return int(m.group(1)) or None
    if not re.search(r"\d{4}-\d{2}-\d{2}", value):
        return None
    out = run(["date", "-d", value, "+%s"]).strip()
    return int(out) if out.isdigit() else None


def unit_kind(unit):
    if unit.startswith("build-image@"):
        return "image", unit[len("build-image@") : -len(".service")]
    if unit.startswith("build-bootc@"):
        return "bootc", unit[len("build-bootc@") : -len(".service")]
    if unit == "build-aur.service":
        return "aur", None
    if unit == "build-iso.service":
        return "iso", None
    return "other", None


def checkout_recipes():
    """Device recipes of the checkout: the directories of image/arkdep-build.d with a name.sh"""
    d = os.path.join(CHECKOUT, "image", "arkdep-build.d")
    try:
        return sorted(r for r in os.listdir(d) if os.path.isfile(os.path.join(d, r, "name.sh")))
    except OSError:
        return []


def build_units():
    """The units with a build-* timer (build-aur and the scheduled images), the arkdep and bootc
    units of every recipe (scheduled or manual, see ./install) and build-iso (manual)."""
    out = run(["systemctl", "list-units", "--all", "--plain", "--no-legend", "--type=timer", "build-*"])
    timers = {t[: -len(".timer")] + ".service": t for t in (line.split()[0] for line in out.splitlines() if line.strip())}
    units = set(timers) | {"build-iso.service"}
    units |= {f"build-{kind}@{r}.service" for r in checkout_recipes() for kind in ("image", "bootc")}
    return sorted(units), timers


def last_run_from_journal(unit):
    """(started, finished, result) of the last run, from the journal: systemd forgets the
    timestamps of inactive units on reboot, the (persistent) journal does not."""
    started = finished = result = None
    for line in run(["journalctl", f"UNIT={unit}", "_PID=1", "-o", "json", "-n", "200",
                     "--no-pager"]).splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        ts = int(entry.get("__REALTIME_TIMESTAMP", 0)) // 1_000_000
        msg = entry.get("MESSAGE_ID")
        if msg == MSG_STARTING:
            started, finished, result = ts, None, None
        elif msg in (MSG_JOB_DONE, MSG_JOB_FAILED) and started:
            finished = ts
            result = result or ("success" if entry.get("JOB_RESULT") == "done" else entry.get("JOB_RESULT"))
        elif msg == MSG_UNIT_FAILED and started:
            result = entry.get("UNIT_RESULT")
    return started, finished, result


def unit_status(unit, timer, now):
    p = show(unit, UNIT_PROPS)
    if p.get("LoadState") not in ("loaded",):
        return None
    started = epoch(p.get("InactiveExitTimestamp"))
    finished = epoch(p.get("InactiveEnterTimestamp"))
    result = p.get("Result")
    active = p.get("ActiveState")
    if not started and active == "inactive":  # not run since boot: look further back
        started, finished, result = last_run_from_journal(unit)
    if active in ("activating", "active", "reloading", "deactivating"):
        state, finished = "running", None
    elif active == "failed" or (started and result not in ("success", None)):
        state = "failed"
    elif started:
        state = "ok"
    else:
        state = "never"
    duration = None
    if started and state == "running":
        duration = now - started
    elif started and finished and finished >= started:
        duration = finished - started
    t = show(timer, TIMER_PROPS) if timer else {}
    kind, target = unit_kind(unit)
    return {
        "unit": unit,
        "kind": kind,
        "target": target,
        "description": p.get("Description", ""),
        "state": state,
        "result": result,
        "started": started,
        "finished": finished,
        "duration": duration,
        "next": epoch(t.get("NextElapseUSecRealtime")),
        "scheduled": timer is not None,
        "log": f"logs/{unit}.txt" if started else None,
    }


def unit_log(unit, started):
    """Journal of the last run (container output included: podman logs it under the unit)."""
    out = run(["journalctl", "-u", unit, "--since", f"@{started}", "-n", str(LOG_LINES),
               "-o", "short-iso", "--no-pager", "--no-hostname"])
    return ANSI.sub("", out)


def read_pkgs(path):
    try:
        with open(path) as f:
            return dict(line.split(maxsplit=1) for line in map(str.strip, f) if " " in line)
    except OSError:
        return None


def pkg_diff(old, new):
    return {
        "added": sorted([n, v] for n, v in new.items() if n not in old),
        "removed": sorted([n, v] for n, v in old.items() if n not in new),
        "updated": sorted([n, old[n], v] for n, v in new.items() if n in old and old[n] != v),
    }


def recipe_images(repo, recipe):
    """Images listed in the recipe database (newest first), with the changes since the previous one."""
    base = os.path.join(repo, recipe)
    try:
        with open(os.path.join(base, "database")) as f:
            names = [line.split(":", 1)[0] for line in map(str.strip, f) if line]
    except OSError:
        return []
    images = []
    for name in names:
        try:
            st = os.stat(os.path.join(base, f"{name}.tar.zst"))
        except OSError:
            continue
        pkgs = read_pkgs(os.path.join(base, f"{name}.pkgs"))
        kernel = next(([k, pkgs[k]] for k in ("linux-cachyos", "linux") if pkgs and k in pkgs), None)
        date = re.search(r"\d{4}-\d{2}-\d{2}", name)
        images.append({
            "name": name,
            "date": date.group(0) if date else None,
            "mtime": int(st.st_mtime),
            "size": st.st_size,
            "packages": len(pkgs) if pkgs is not None else None,
            "kernel": kernel,
            "_pkgs": pkgs,
        })
    for i, img in enumerate(images):
        prev = images[i + 1]["_pkgs"] if i + 1 < len(images) else None
        img["diff"] = pkg_diff(prev, img["_pkgs"]) if prev is not None and img["_pkgs"] is not None else None
    for img in images:
        del img["_pkgs"]
    return images


def registry_get(path, accept=None):
    """(parsed JSON, Docker-Content-Digest) of a registry API path."""
    req = urllib.request.Request(REGISTRY + path, headers={"Accept": accept} if accept else {})
    with urllib.request.urlopen(req, timeout=5) as r:
        return json.load(r), r.headers.get("Docker-Content-Digest")


def bootc_images(repo):
    """bootc images per recipe in the registry (dated tags, newest first), with the package changes
    from the lists bootc/build writes to <repo>/bootc/<recipe>/ and whether they are signed.
    Empty if the registry is down."""
    try:
        names = registry_get("/v2/_catalog")[0].get("repositories") or []
    except (OSError, ValueError):
        return {}
    out = {}
    for name in sorted(names):
        try:
            tags = registry_get(f"/v2/{name}/tags/list")[0].get("tags") or []
            latest = registry_get(f"/v2/{name}/manifests/latest", MANIFEST_TYPES)[1] if "latest" in tags else None
        except (OSError, ValueError):
            continue
        images = []
        for tag in sorted((t for t in tags if DATE_TAG.fullmatch(t)), reverse=True):
            try:
                manifest, digest = registry_get(f"/v2/{name}/manifests/{tag}", MANIFEST_TYPES)
                config = registry_get(f"/v2/{name}/blobs/{manifest['config']['digest']}")[0]
            except (OSError, ValueError, KeyError):
                continue
            created = epoch(config.get("created"))
            pkgs = read_pkgs(os.path.join(repo, "bootc", name, f"{name}-{tag}.pkgs"))
            kernel = next(([k, pkgs[k]] for k in ("linux-cachyos", "linux") if pkgs and k in pkgs), None)
            images.append({
                "tag": tag,
                "created": created,
                "size": sum(layer["size"] for layer in manifest.get("layers", [])),
                "layers": len(manifest.get("layers", [])),
                "latest": digest is not None and digest == latest,
                # bootc/build's sigstore signature: a tag named after the manifest digest
                "signed": digest is not None and f"{digest.replace(':', '-')}.sig" in tags,
                "packages": len(pkgs) if pkgs is not None else None,
                "kernel": kernel,
                "_pkgs": pkgs,
            })
        for i, img in enumerate(images):
            prev = images[i + 1]["_pkgs"] if i + 1 < len(images) else None
            img["diff"] = pkg_diff(prev, img["_pkgs"]) if prev is not None and img["_pkgs"] is not None else None
        for img in images:
            del img["_pkgs"]
        if images:  # a repository whose images were all deleted stays in the catalog
            out[name] = images
    return out


def aur_packages(repo):
    """Newest file of each package in the [aur] repository. origin: list (aur/packages.list),
    local (aur/local/<name>/PKGBUILD) or dependency."""
    base = os.path.join(repo, "aur")
    listed = set()
    try:
        with open(os.path.join(CHECKOUT, "aur", "packages.list")) as f:
            listed = {line.split("#")[0].strip() for line in f} - {""}
    except OSError:
        pass
    local_dir = os.path.join(CHECKOUT, "aur", "local")
    try:
        local = {d for d in os.listdir(local_dir) if os.path.isfile(os.path.join(local_dir, d, "PKGBUILD"))}
    except OSError:
        local = set()
    newest = {}
    try:
        files = os.listdir(base)
    except OSError:
        return {"updated": None, "packages": []}
    for name in files:
        if not name.endswith(".pkg.tar.zst"):
            continue
        parts = name[: -len(".pkg.tar.zst")].rsplit("-", 3)
        if len(parts) != 4:
            continue
        pkg, ver, rel, _arch = parts
        mtime = int(os.stat(os.path.join(base, name)).st_mtime)
        if pkg not in newest or mtime > newest[pkg]["mtime"]:
            origin = "local" if pkg in local else "list" if pkg in listed else "dependency"
            newest[pkg] = {"name": pkg, "version": f"{ver}-{rel}", "mtime": mtime,
                           "origin": origin, "file": name}
    try:
        updated = int(os.stat(os.path.join(base, "aur.db.tar.zst")).st_mtime)
    except OSError:
        updated = None
    return {"updated": updated, "packages": sorted(newest.values(), key=lambda p: p["name"])}


def isos(repo):
    base = os.path.join(repo, "iso")
    sums = {}
    try:
        with open(os.path.join(base, "sha256sums.txt")) as f:
            for line in f:
                if len(line.split()) == 2:
                    digest, name = line.split()
                    sums[name.lstrip("*")] = digest
    except OSError:
        pass
    out = []
    for name in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        if name.endswith(".iso"):
            st = os.stat(os.path.join(base, name))
            out.append({"name": name, "size": st.st_size, "mtime": int(st.st_mtime),
                        "sha256": sums.get(name)})
    return out


def commit():
    out = run(["git", "-c", f"safe.directory={CHECKOUT}", "-C", CHECKOUT,
               "log", "-1", "--format=%h%x00%ct%x00%s"])
    parts = out.strip().split("\0")
    return {"hash": parts[0], "date": int(parts[1]), "subject": parts[2]} if len(parts) == 3 else None


def write(path, text):
    """Atomic write, so the page never reads a half-written file."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--out", default="/run/distro-status")
    ap.add_argument("--repo", default="/mnt/repo")
    args = ap.parse_args()
    now = int(time.time())
    os.makedirs(os.path.join(args.out, "logs"), exist_ok=True)

    units, timers = build_units()
    statuses = []
    for unit in units:
        s = unit_status(unit, timers.get(unit), now)
        if s is None:
            continue
        statuses.append(s)
        if s["started"]:
            write(os.path.join(args.out, s["log"]), unit_log(unit, s["started"]))

    recipes = sorted(d for d in os.listdir(args.repo)
                     if os.path.isfile(os.path.join(args.repo, d, "database")))
    st = os.statvfs(args.repo)
    status = {
        "generated": now,
        "host": socket.gethostname(),
        "commit": commit(),
        "storage": {"total": st.f_blocks * st.f_frsize, "free": st.f_bavail * st.f_frsize},
        "units": statuses,
        "recipes": {r: recipe_images(args.repo, r) for r in recipes},
        "bootc": bootc_images(args.repo),
        "aur": aur_packages(args.repo),
        "iso": isos(args.repo),
    }
    write(os.path.join(args.out, "recipes.txt"), "".join(f"{r}\n" for r in recipes))
    write(os.path.join(args.out, "status.json"), json.dumps(status, separators=(",", ":")))


if __name__ == "__main__":
    main()
