#!/usr/bin/env bash
# Usage: ci/check
# Static checks of the repository, run by GitHub Actions on every push (.github/workflows/check.yml)
# and by hand before pushing. The builds themselves stay on the build server (LAN, signing key).
# - shellcheck of every shell script (shebang), warnings and errors; shellcheck runs from its
#   container image (podman or docker), pinned so that every machine reports the same
# - Python syntax of the serve/ scripts (without writing bytecode)
# - no stray files tracked (Python bytecode, editor swap files)
# - commands are executable: files in bin/ and sbin/, and extensionless scripts of the tools
# - recipe structure: what arkdep-build needs from each device recipe

set -uo pipefail

cd "$(dirname "$(readlink -f "$0")")/.." || exit 1

SHELLCHECK_IMAGE=docker.io/koalaman/shellcheck:v0.11.0
RECIPES=image/arkdep-build.d

failed=()
fail() { failed+=("$1"); }

mapfile -t files < <(git ls-files)
shebang() { [[ -f $1 && ! -L $1 ]] && head -n1 "$1" 2>/dev/null | grep -qE "$2"; }

echo "== shellcheck"
shell=()
for f in "${files[@]}"; do
	shebang "$f" '^#!.*[/ ](ba)?sh( |$)' && shell+=("$f")
done
if command -v podman >/dev/null; then
	runner=(podman run --rm -q -v "$PWD:/mnt:ro,Z" -w /mnt "$SHELLCHECK_IMAGE")
elif command -v docker >/dev/null; then
	runner=(docker run --rm -v "$PWD:/mnt:ro" -w /mnt "$SHELLCHECK_IMAGE")
else
	echo "No podman or docker: using the local shellcheck ($(shellcheck --version | sed -n 2p))"
	runner=(shellcheck)
fi
"${runner[@]}" --severity=warning --format=gcc "${shell[@]}" || fail shellcheck
echo "${#shell[@]} shell scripts"

echo "== Python syntax"
for f in "${files[@]}"; do
	shebang "$f" '^#!.*python' || [[ $f == *.py ]] || continue
	python3 -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' "$f" || fail "python $f"
done

echo "== Stray files"
stray=$(printf '%s\n' "${files[@]}" | grep -E '(^|/)__pycache__/|\.py[co]$|\.sw[op]$|~$')
[[ -z $stray ]] || { echo "$stray"; fail "stray files"; }

echo "== Executable commands"
while read -r mode _ _ f; do
	[[ -f $f && ! -L $f ]] || continue
	if [[ $f =~ (^|/)s?bin/[^/]+$ ]] || { [[ $f =~ ^[a-z]+/[^/.]+$ || $f == install ]] && shebang "$f" '^#!'; }; then
		[[ $mode == 100755 ]] || { echo "$f is not executable ($mode)"; fail "exec bit"; }
	fi
done < <(git ls-files -s)

echo "== Recipes"
for dir in "$RECIPES"/*/; do
	recipe=$(basename "$dir")
	[[ -f $dir/name.sh ]] || continue  # common/, depends/
	# package.list is required even if empty: older arkdep-build silently skipped the package stage
	for f in name.sh type bootstrap.list package.list depends.list; do
		[[ -f $dir/$f ]] || { echo "$recipe: no $f"; fail "recipe $recipe"; }
	done
	# arkdep-build reads these only from the device directory
	for f in pacman.conf mirrorlist extensions; do
		[[ -L $dir/$f && -e $dir/$f ]] || { echo "$recipe: $f is not a working link to ../common"; fail "recipe $recipe"; }
	done
	while read -r dep; do
		[[ -d $RECIPES/$dep ]] || { echo "$recipe: depends.list names a missing layer: $dep"; fail "recipe $recipe"; }
	done < <(grep -vE '^\s*(#|$)' "$dir/depends.list" 2>/dev/null)
done

echo
if ((${#failed[@]})); then
	printf 'FAILED: %s\n' "${failed[@]}" | sort -u
	exit 1
fi
echo "All checks passed"
